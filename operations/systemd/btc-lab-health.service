[Unit]
Description=btc-lab smoke health check (oneshot, cada 5 min via timer)
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=30
ExecStart=/usr/bin/python3 "/home/jorgextech/dev/personal/Crypto Trading Bot/operations/health.py" "--container" "btc-lab-smoke-1" "--logfile" "/home/jorgextech/dev/personal/Crypto Trading Bot/storage/runtime/smoke/freqtrade.log" "--output" "/home/jorgextech/dev/personal/Crypto Trading Bot/storage/health.json" "--lock" "/home/jorgextech/dev/personal/Crypto Trading Bot/storage/health.lock"
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
